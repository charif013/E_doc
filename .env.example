APP_NAME="e-Doc อบต.พร่อน"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# LINE Login and Messaging API channels must be under the same LINE Provider.
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_SECRET=
LINE_BOT_TOKEN=
LINE_LOGIN_REDIRECT_URI="${APP_URL}/line/callback"

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=e_doc
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
QUEUE_RETRY_AFTER=900
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# พาธ Python ที่ติดตั้ง docling และ PyPDF2 แล้ว (ระบุพาธเต็มบน Windows ได้)
PYTHON_COMMAND="C:\\path\\to\\python.exe"
# เว้นว่างได้หากต้องการใช้ Python ตัวเดียวกับ PYTHON_COMMAND
PYTHON_EXECUTABLE=

# AI ช่วยร่างหนังสือ (เว้นว่างเพื่อปิดฟังก์ชัน)
TYPHOON_API_KEY=
TYPHOON_MODEL=typhoon-v2.5-30b-a3b-instruct
TYPHOON_ENDPOINT=https://api.opentyphoon.ai/v1/chat/completions
TYPHOON_TIMEOUT=60
DOCUMENT_EXTRACTION_SCRIPT=extract_doc.py
DOCUMENT_EXTRACTION_TIMEOUT=600
LEAVE_DELEGATE_REMIND_AFTER_HOURS=24
LEAVE_DELEGATE_ESCALATE_AFTER_HOURS=48
