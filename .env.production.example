APP_NAME="e-Doc อบต.พร่อน"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://edoc.example.go.th

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=e_docv2
DB_USERNAME=edoc_app
DB_PASSWORD=

V2_DB_HOST=127.0.0.1
V2_DB_PORT=3306
V2_DB_DATABASE=e_docv2
V2_DB_USERNAME=edoc_app
V2_DB_PASSWORD=
EDOC_V2_ENABLED=true
EDOC_V2_WRITE_ENABLED=true
EDOC_V2_CONNECTION=mysql_v2
EDOC_V2_DOCUMENT_READS=true
EDOC_V2_MIGRATION_PATH=database/migrations-v2

LEGACY_RO_DB_HOST=127.0.0.1
LEGACY_RO_DB_PORT=3306
LEGACY_RO_DB_DATABASE=edoc_db
LEGACY_RO_DB_USERNAME=edoc_legacy_reader
LEGACY_RO_DB_PASSWORD=

CACHE_DRIVER=redis
QUEUE_CONNECTION=database
QUEUE_RETRY_AFTER=900
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
FILESYSTEM_DISK=local

EDOC_RUN_SCHEDULED_QUEUE_WORKER=false
EDOC_QUEUE_STALE_AFTER_MINUTES=10
EDOC_FAILED_JOBS_LAST_HOUR_MAX=0
EDOC_MINIMUM_FREE_DISK_MB=2048
EDOC_RETENTION_MONTHS=3

# ใช้เฉพาะตอน provision ครั้งแรกและนำออกหลัง seed สำเร็จ
EDOC_ADMIN_EMAIL=
EDOC_ADMIN_PASSWORD=

LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_SECRET=
LINE_BOT_TOKEN=
LINE_BOT_CHANNEL_SECRET=
LINE_OFFICIAL_ACCOUNT_ID=
LINE_LOGIN_REDIRECT_URI="${APP_URL}/line/callback"

PYTHON_COMMAND=/opt/edoc/venv/bin/python
PYTHON_EXECUTABLE=/opt/edoc/venv/bin/python
DOCUMENT_EXTRACTION_SCRIPT=extract_doc.py
DOCUMENT_EXTRACTION_TIMEOUT=600

TYPHOON_API_KEY=
TYPHOON_MODEL=typhoon-v2.5-30b-a3b-instruct
TYPHOON_ENDPOINT=https://api.opentyphoon.ai/v1/chat/completions
TYPHOON_TIMEOUT=60
TYPHOON_CA_BUNDLE=
GOOGLE_API_KEY=

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
